# Copie para .env e ajuste. Lido pelo docker-compose (serviço api) e pode ser
# usado também na execução local. Nunca versione o .env.

# Chave de assinatura dos JWT (mínimo 32 bytes). Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=cole-aqui-a-chave-gerada

# Senha do admin criada na primeira execução (padrão da atividade: admin123).
# ADMIN_INITIAL_PASSWORD=admin123
